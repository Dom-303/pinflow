{
  "compilerOptions": {
    "baseUrl": ".",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "importHelpers": true,
    "isolatedModules": true,
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@pinflow/core": ["packages/pinflow-core/src/index.ts"],
      "@pinflow/core/*": ["packages/pinflow-core/src/*"],
      "@pinflow/runtime": ["packages/pinflow-runtime/src/index.ts"],
      "@pinflow/runtime/*": ["packages/pinflow-runtime/src/*"],
      "@pinflow/react": ["packages/pinflow-react/src/index.ts"],
      "@pinflow/react/*": ["packages/pinflow-react/src/*"],
      "@pinflow/overlay": ["packages/pinflow-overlay/src/index.ts"],
      "@pinflow/overlay/*": ["packages/pinflow-overlay/src/*"],
      "@pinflow/relay": ["packages/pinflow-relay/src/index.ts"],
      "@pinflow/relay/program": [
        "packages/pinflow-relay/src/program/index.ts"
      ],
      "@pinflow/relay/*": ["packages/pinflow-relay/src/*"],
      "pinflow": ["packages/pinflow-cli/src/bin/pinflow.ts"],
      "@pinflow/mcp": ["packages/pinflow-mcp/src/bin/pinflow-mcp.ts"],
      "@pinflow/transform": ["packages/pinflow-transform/src/index.ts"],
      "@pinflow/transform/*": ["packages/pinflow-transform/src/*"],
      "@pinflow/manifest": ["packages/pinflow-manifest/src/index.ts"],
      "@pinflow/manifest/*": ["packages/pinflow-manifest/src/*"],
      "@pinflow/vue": ["packages/pinflow-vue/src/index.ts"],
      "@pinflow/vue/*": ["packages/pinflow-vue/src/*"],
      "@pinflow/nuxt": ["packages/pinflow-nuxt/src/index.ts"],
      "@pinflow/nuxt/*": ["packages/pinflow-nuxt/src/*"],
      "@pinflow/next": ["packages/pinflow-next/src/index.ts"],
      "@pinflow/next/*": ["packages/pinflow-next/src/*"]
    }
  }
}
