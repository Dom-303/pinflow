{
  "name": "pinflow-vscode",
  "displayName": "PinFlow",
  "version": "0.0.1",
  "description": "VS Code extension for viewing the local PinFlow workflow.",
  "type": "module",
  "publisher": "dom-303",
  "main": "./dist/extension.js",
  "icon": "media/icon.png",
  "license": "MIT",
  "preview": true,
  "homepage": "https://github.com/Dom-303/pinflow#readme",
  "bugs": {
    "url": "https://github.com/Dom-303/pinflow/issues"
  },
  "galleryBanner": {
    "color": "#111111",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Other"
  ],
  "keywords": [
    "pinflow",
    "ui-to-code",
    "coding-agent",
    "vscode-extension",
    "developer-tools"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pinflow",
          "title": "PinFlow",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "pinflow": [
        {
          "id": "pinflow.status",
          "name": "Status"
        },
        {
          "id": "pinflow.runs",
          "name": "Runs",
          "type": "webview"
        },
        {
          "id": "pinflow.actions",
          "name": "Actions"
        }
      ]
    },
    "commands": [
      {
        "command": "pinflow.openPanel",
        "title": "PinFlow: Open Panel",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.openContainer",
        "title": "PinFlow: Show Sidebar",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.followRuns",
        "title": "PinFlow: Follow Runs",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.openLatestRun",
        "title": "PinFlow: Open Latest Run",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.startWorkflow",
        "title": "PinFlow: Start Workflow",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.refreshPanel",
        "title": "PinFlow: Refresh Panel",
        "category": "PinFlow",
        "icon": "$(refresh)"
      },
      {
        "command": "pinflow.externalClaim",
        "title": "PinFlow: Claim External Task",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.externalComplete",
        "title": "PinFlow: Complete External Task",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.externalFail",
        "title": "PinFlow: Fail External Task",
        "category": "PinFlow"
      },
      {
        "command": "pinflow.openSettings",
        "title": "PinFlow: Open Settings",
        "category": "PinFlow",
        "icon": "$(gear)"
      },
      {
        "command": "pinflow.runInit",
        "title": "PinFlow: Run Init",
        "category": "PinFlow",
        "icon": "$(rocket)"
      },
      {
        "command": "pinflow.openDocumentation",
        "title": "PinFlow: Open Documentation",
        "category": "PinFlow",
        "icon": "$(book)"
      },
      {
        "command": "pinflow.openPreview",
        "title": "PinFlow: Open Preview",
        "category": "PinFlow",
        "icon": "$(link-external)"
      }
    ],
    "configuration": {
      "title": "PinFlow",
      "properties": {
        "pinflow.refreshIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 500,
          "maximum": 60000,
          "description": "How often the PinFlow sidebar polls the workspace for new run evidence (in milliseconds). Lower values are more responsive but cost more disk I/O. Range: 500-60000."
        },
        "pinflow.runs.todayExpandedByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Whether the 'Today' group in the Runs view starts expanded."
        },
        "pinflow.timeFormat": {
          "type": "string",
          "enum": [
            "24h",
            "12h"
          ],
          "default": "24h",
          "description": "Time format for run labels in the Runs view. '24h' shows '14:32', '12h' shows '2:32 PM'."
        },
        "pinflow.notifications.runFailed": {
          "type": "boolean",
          "default": true,
          "description": "Show a VS Code notification toast when a PinFlow run fails."
        },
        "pinflow.externalHandoff.defaultProvider": {
          "type": "string",
          "enum": [
            "codex",
            "claude"
          ],
          "default": "codex",
          "description": "Default provider used when claiming an external PinFlow task via 'Claim External Task'."
        },
        "pinflow.workspace.preferredFolder": {
          "type": "string",
          "default": "",
          "description": "Absolute or relative path to the workspace folder PinFlow should track. Leave empty to use auto-detection (the first folder with a running relay, then the first configured folder, then the first folder)."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "pinflow.openSettings",
          "when": "view == pinflow.status",
          "group": "navigation"
        },
        {
          "command": "pinflow.refreshPanel",
          "when": "view == pinflow.runs",
          "group": "navigation"
        },
        {
          "command": "pinflow.refreshPanel",
          "when": "view == pinflow.actions",
          "group": "navigation"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "pinflow.status",
        "when": "workbenchState != empty && pinflow.notConfigured",
        "contents": "PinFlow ist in diesem Workspace nicht eingerichtet.\n\n[$(rocket) PinFlow einrichten](command:pinflow.runInit)\n\n[$(book) Dokumentation öffnen](command:pinflow.openDocumentation)\n\nVoraussetzung: PinFlow CLI verfügbar (lokal in deinem Projekt oder global installiert)."
      },
      {
        "view": "pinflow.status",
        "when": "workbenchState == empty",
        "contents": "PinFlow braucht einen geöffneten Ordner.\n\n[$(folder-opened) Ordner öffnen](command:vscode.openFolder)"
      }
    ]
  },
  "dependencies": {
    "lit": "^3.1.0",
    "@vscode/codicons": "^0.0.36"
  },
  "devDependencies": {
    "happy-dom": "^15.11.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "vitest run --config vite.config.ts",
    "package:vsix": "corepack pnpm nx build pinflow-vscode && corepack pnpm dlx @vscode/vsce package --no-dependencies --out ../../tmp/pinflow-vscode.vsix"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Dom-303/pinflow.git",
    "directory": "packages/pinflow-vscode"
  }
}
