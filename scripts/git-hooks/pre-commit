#!/usr/bin/env bash
# Preview-pipeline guard — addressed to the coding agent.
#
# Prints an instruction block when staged files touch
# preview-critical paths. Exit is always 0 (never blocks a commit).
# The user doesn't need to act on this; the AI coding agent running
# the commit does.
#
# Activate with: pnpm hooks:install  (sets core.hooksPath once).
# Deactivate with: git config --unset core.hooksPath

set -euo pipefail

PREVIEW_PATHS=(
  'packages/pinflow-overlay/'
  'packages/pinflow-react/src/vite/'
  'packages/pinflow-runtime/src/'
  'packages/pinflow-test-fixtures/fixtures/vite/v5/react-18-ts/'
  'packages/pinflow-test-fixtures/shared/pinflow-local-workspace-overrides'
  'scripts/pinflow-preview.ts'
  'tsconfig.base.json'
)

staged=$(git diff --cached --name-only --diff-filter=ACMR || true)

if [ -z "$staged" ]; then
  exit 0
fi

hits=()
while IFS= read -r file; do
  for prefix in "${PREVIEW_PATHS[@]}"; do
    if [[ "$file" == "$prefix"* ]]; then
      hits+=("$file")
      break
    fi
  done
done <<<"$staged"

if [ ${#hits[@]} -eq 0 ]; then
  exit 0
fi

YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
RESET='\033[0m'

printf "\n${YELLOW}═══════════════════════════════════════════════════════════════${RESET}\n"
printf "${BOLD}${YELLOW}[pinflow preview guard — ATTENTION CODING AGENT]${RESET}\n\n"
printf "You (the AI coding agent running this commit) just staged changes\n"
printf "to preview-critical files:\n\n"
for file in "${hits[@]}"; do
  printf "  ${CYAN}%s${RESET}\n" "$file"
done
printf "\n${BOLD}Before reporting this commit as done, you MUST:${RESET}\n"
printf "  1. Run: ${CYAN}pnpm pinflow:preview:e2e${RESET}\n"
printf "  2. Include the result in your reply to the user.\n"
printf "  3. If the e2e fails, ${BOLD}do not${RESET} mark the task complete.\n"
printf "     The overlay preview is broken; fix before proceeding.\n\n"
printf "Context the agent should read before editing these files:\n"
printf "  ${CYAN}.claude/rules/preview-pipeline.md${RESET}\n"
printf "${YELLOW}═══════════════════════════════════════════════════════════════${RESET}\n\n"

exit 0
