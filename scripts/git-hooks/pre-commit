#!/usr/bin/env bash
# Preview-pipeline heads-up for the coding agent.
#
# When staged files touch preview-critical paths, print a short
# context note so the AI agent driving the commit knows what area
# it's in. This is informational — no instructions, no blockers,
# no "you must". Exit is always 0.
#
# Activate with: pnpm hooks:install  (sets core.hooksPath once).
# Deactivate with: git config --unset core.hooksPath

set -euo pipefail

PREVIEW_PATHS=(
  'packages/pinflow-overlay/'
  'packages/pinflow-react/src/vite/'
  'packages/pinflow-runtime/src/'
  'packages/pinflow-test-fixtures/fixtures/vite/v5/react-18-ts/'
  'packages/pinflow-test-fixtures/shared/pinflow-local-workspace-overrides'
  'scripts/pinflow-preview.ts'
  'tsconfig.base.json'
)

staged=$(git diff --cached --name-only --diff-filter=ACMR || true)

if [ -z "$staged" ]; then
  exit 0
fi

hits=()
while IFS= read -r file; do
  for prefix in "${PREVIEW_PATHS[@]}"; do
    if [[ "$file" == "$prefix"* ]]; then
      hits+=("$file")
      break
    fi
  done
done <<<"$staged"

if [ ${#hits[@]} -eq 0 ]; then
  exit 0
fi

YELLOW='\033[0;33m'
CYAN='\033[0;36m'
RESET='\033[0m'

printf "\n${YELLOW}[pinflow preview heads-up for the coding agent]${RESET}\n"
printf "You are editing preview-critical files:\n"
for file in "${hits[@]}"; do
  printf "  ${CYAN}%s${RESET}\n" "$file"
done
printf "Carry on with the task. When you're at a natural stopping\n"
printf "point, ${CYAN}pnpm pinflow:preview:e2e${RESET} (~3s) quickly confirms the\n"
printf "overlay still boots. Context: ${CYAN}.claude/rules/preview-pipeline.md${RESET}\n\n"

exit 0
