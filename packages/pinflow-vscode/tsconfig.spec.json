{
  "extends": "./tsconfig.lib.json",
  "compilerOptions": {
    "outDir": "./test-output/tsc",
    "types": [
      "node",
      "vitest/globals"
    ],
    "lib": [
      "es2024",
      "ESNext.Array",
      "ESNext.Collection",
      "ESNext.Iterator",
      "ESNext.Promise",
      "DOM"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.spec.ts"
  ]
}
