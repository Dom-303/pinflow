{
  "name": "pinflow-nuxt",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/pinflow-nuxt/src",
  "tags": [
    "scope:adapter",
    "type:adapter-lib",
    "type:test"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/dist/packages/pinflow-nuxt"
      ],
      "options": {
        "rootDir": "packages/pinflow-nuxt/src",
        "outputPath": "dist/packages/pinflow-nuxt",
        "main": "packages/pinflow-nuxt/src/index.ts",
        "tsConfig": "packages/pinflow-nuxt/tsconfig.lib.json",
        "generatePackageJson": true,
        "generateExportsField": true,
        "assets": [
          "packages/pinflow-nuxt/*.md",
          {
            "input": "packages/pinflow-nuxt/src/runtime",
            "glob": "**/*.ts",
            "output": "runtime"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "eslintConfig": "eslint.config.mjs",
        "lintFilePatterns": [
          "packages/pinflow-nuxt/**/*.ts",
          "packages/pinflow-nuxt/**/*.tsx"
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{projectRoot}/test-output"
      ],
      "options": {
        "config": "packages/pinflow-nuxt/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:noop"
    },
    "watch-deps": {
      "executor": "nx:noop"
    },
    "build-deps": {
      "executor": "nx:noop"
    }
  }
}
