{
  "name": "pinflow-overlay",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/pinflow-overlay/src",
  "tags": [
    "scope:infra",
    "type:lib",
    "type:test"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{workspaceRoot}/dist/packages/pinflow-overlay"
      ],
      "options": {
        "rootDir": "packages/pinflow-overlay/src",
        "outputPath": "dist/packages/pinflow-overlay",
        "main": "packages/pinflow-overlay/src/index.ts",
        "tsConfig": "packages/pinflow-overlay/tsconfig.lib.json",
        "generatePackageJson": true,
        "generateExportsField": true,
        "assets": [
          "packages/pinflow-overlay/*.md",
          {
            "input": "packages/pinflow-overlay/src/components/logo/assets",
            "glob": "**/*",
            "output": "components/logo/assets"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "eslintConfig": "eslint.config.mjs",
        "lintFilePatterns": [
          "packages/pinflow-overlay/**/*.ts",
          "packages/pinflow-overlay/**/*.tsx"
        ]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": [
        "{projectRoot}/test-output"
      ],
      "options": {
        "config": "packages/pinflow-overlay/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:noop"
    },
    "watch-deps": {
      "executor": "nx:noop"
    },
    "build-deps": {
      "executor": "nx:noop"
    }
  }
}
