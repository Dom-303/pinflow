  "license": "MIT",
  "keywords": [
    "pinflow",
    "pinflow-compat",
    "pixel-to-code",
    "ui-to-code",
    "dom-annotation",
    "annotation",
    "source-mapping",
    "runtime-context",
    "element-inspector",
    "component-inspector",
    "mcp",
    "model-context-protocol",
    "developer-tools",
    "devtools",
    "react",
    "vue",
    "nextjs",
    "nuxt"
  ],
  "skills": "./skills",
  "mcpServers": {
    "pinflow": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@pinflow/mcp"
      ]
    }
  }
