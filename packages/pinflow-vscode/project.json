{
  "name": "pinflow-vscode",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "packages/pinflow-vscode/src",
  "tags": ["scope:infra", "type:app"],
  "targets": {
    "build:webview": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist/runs-webview"],
      "inputs": [
        "{projectRoot}/src/runs-webview/**",
        "{projectRoot}/vite.webview.config.ts",
        "{projectRoot}/scripts/check-webview-bundle-size.mjs"
      ],
      "options": {
        "command": "vite build --config vite.webview.config.ts && cp node_modules/@vscode/codicons/dist/codicon.css node_modules/@vscode/codicons/dist/codicon.ttf ./dist/runs-webview/ && node scripts/check-webview-bundle-size.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "build:webview"],
      "outputs": [
        "{projectRoot}/dist/extension.cjs",
        "{projectRoot}/dist/extension.cjs.map"
      ],
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "!{projectRoot}/src/runs-webview/**",
        "!{projectRoot}/src/**/*.spec.ts",
        "!{projectRoot}/src/**/*.test.ts",
        "{projectRoot}/esbuild.config.mjs",
        "{projectRoot}/tsconfig.lib.json",
        "{workspaceRoot}/tsconfig.base.json"
      ],
      "options": {
        "command": "node esbuild.config.mjs",
        "cwd": "{projectRoot}"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "eslintConfig": "eslint.config.mjs",
        "lintFilePatterns": ["packages/pinflow-vscode/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "outputs": ["{projectRoot}/test-output"],
      "options": {
        "config": "packages/pinflow-vscode/vite.config.ts"
      }
    },
    "typecheck": {
      "executor": "nx:noop"
    }
  }
}
